    <!-- Δ26: what goes where, without the names of the providers. -->
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_audio">While you speak, the audio goes to your backend and from there to a speech recognition service, which turns it into text. The phone does not keep the audio.</string>
    <string name="settings_privacy_text">The text goes to an AI service only with a profile. With “No changes” it goes nowhere.</string>
    <string name="settings_privacy_phone">The phone keeps, on the device only, the History (the text, the app and the timings of each dictation), the Dictionary and the settings. The Dictionary terms go to the speech recognition with every dictation.</string>
    <string name="settings_privacy_never">In password fields Pesto does not appear. In private browsing (incognito) the text is entered in the field, but it is not written to the History.</string>
