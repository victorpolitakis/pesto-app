<?xml version="1.0" encoding="utf-8"?>
<!--
  flagInputMethodEditor: the service's own input method next to Gboard (EditorInfo, commitText, API 33+).
  flagRetrieveInteractiveWindows: the keyboard window and its mic key.
  isAccessibilityTool="false": honest, Pesto is a dictation app.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagInputMethodEditor|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
